{
  // NEXOLV Prospector — configuration Cloudflare Workers
  
  "name": "nexolv-prospector",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/demo/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "nexolv-prospector" }],
  // Mode automatique : chaque heure, du lundi au vendredi, de 9 h à 18 h (heure de Paris en hiver)
  "triggers": { "crons": ["0 8-17 * * 1-5"] },
  "vars": {
    "URL": "https://app.nexolv.fr",
    "SMTP_USER": "contact@nexolv.fr",
    "PAY_ESSENTIEL": "https://buy.stripe.com/28E3cufo3aDBf3RemY53O00",
    "PAY_PRO": "https://buy.stripe.com/9B63cu1xdcLJ3l95Qs53O01",
    "PAY_SANS_APPORT": "https://buy.stripe.com/6oU28q5Nt6nl7Bpfr253O02"
  },
  "observability": { "enabled": true }
}
